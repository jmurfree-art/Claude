# ── Supabase (required) ────────────────────────────────────────────────
# Find these in Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ── App ────────────────────────────────────────────────────────────────
# Base URL of the deployed app (used for auth email redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Video provider (optional) ──────────────────────────────────────────
# Force a provider: "heygen" | "local" | "duix" | "mock". Leave empty to
# auto-select: heygen when HEYGEN_API_KEY is set, otherwise "local".
VIDEO_PROVIDER=

# HeyGen API key (only if you want HeyGen renders — entirely optional).
# Get one at https://app.heygen.com/settings (API tab).
HEYGEN_API_KEY=

# "local" provider — FREE renders with no API key or subscription:
# Microsoft Edge neural TTS (multilingual) + ffmpeg compositing.
# Requires ffmpeg on the machine (apt install ffmpeg / brew install ffmpeg).
FFMPEG_PATH=
# Where rendered MP4s are stored (default: ./.local-renders)
LOCAL_RENDER_DIR=

# Duix-Avatar (EXPERIMENTAL, self-hosted — https://github.com/duixcom/Duix-Avatar)
# Only used when VIDEO_PROVIDER=duix. Point at your Docker deployment and
# declare your locally trained models:
DUIX_VIDEO_API_URL=http://127.0.0.1:8383
DUIX_TTS_API_URL=http://127.0.0.1:18180
DUIX_AVATARS=
DUIX_VOICES=

# ── Lip-sync engines (all optional) ────────────────────────────────────
# "Auto" picks the first configured engine: HeyGen → Replicate → fal →
# mock (simulated, no keys needed). All keys stay server-side.

# HeyGen: reuses HEYGEN_API_KEY above. Optional stock avatar for lip-sync
# jobs that don't upload a face image:
HEYGEN_DEFAULT_AVATAR_ID=

# Replicate (https://replicate.com/account/api-tokens). Also set the
# version hash of a Wav2Lip-style model (model page → API → "version"):
REPLICATE_API_TOKEN=
REPLICATE_LIPSYNC_VERSION=

# fal.ai (https://fal.ai/dashboard/keys). Model id is overridable:
FAL_KEY=
FAL_LIPSYNC_MODEL=fal-ai/musetalk

# ── Stripe (placeholder — billing is not wired up yet) ─────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
