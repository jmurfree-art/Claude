# ── Supabase (required) ────────────────────────────────────────────────
# Find these in Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ── App ────────────────────────────────────────────────────────────────
# Base URL of the deployed app (used for auth email redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Video provider (optional) ──────────────────────────────────────────
# Force a provider: "heygen" | "duix" | "mock". Leave empty to auto-select
# (heygen when HEYGEN_API_KEY is set, otherwise mock).
VIDEO_PROVIDER=

# HeyGen API key. Get one at https://app.heygen.com/settings (API tab).
# If this is missing (and VIDEO_PROVIDER is empty), the app runs in MOCK
# MODE: fake avatars/voices and a simulated render pipeline — the full flow
# works for free with no external calls.
HEYGEN_API_KEY=

# Duix-Avatar (EXPERIMENTAL, self-hosted — https://github.com/duixcom/Duix-Avatar)
# Only used when VIDEO_PROVIDER=duix. Point at your Docker deployment and
# declare your locally trained models:
DUIX_VIDEO_API_URL=http://127.0.0.1:8383
DUIX_TTS_API_URL=http://127.0.0.1:18180
DUIX_AVATARS=
DUIX_VOICES=

# ── Stripe (placeholder — billing is not wired up yet) ─────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
