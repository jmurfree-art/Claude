# ── Supabase (required) ────────────────────────────────────────────────
# Find these in Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ── App ────────────────────────────────────────────────────────────────
# Base URL of the deployed app (used for auth email redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Video provider (optional) ──────────────────────────────────────────
# Force a provider: "heygen" | "local" | "duix" | "mock". Leave empty to
# auto-select: heygen when HEYGEN_API_KEY is set, otherwise "local".
VIDEO_PROVIDER=

# HeyGen API key (only if you want HeyGen renders — entirely optional).
# Get one at https://app.heygen.com/settings (API tab).
HEYGEN_API_KEY=

# "local" provider — FREE renders with no API key or subscription:
# Microsoft Edge neural TTS (multilingual) + ffmpeg compositing.
# Requires ffmpeg on the machine (apt install ffmpeg / brew install ffmpeg).
FFMPEG_PATH=
# Where rendered MP4s are stored (default: ./.local-renders)
LOCAL_RENDER_DIR=

# Duix-Avatar (EXPERIMENTAL, self-hosted — https://github.com/duixcom/Duix-Avatar)
# Only used when VIDEO_PROVIDER=duix. Point at your Docker deployment and
# declare your locally trained models:
DUIX_VIDEO_API_URL=http://127.0.0.1:8383
DUIX_TTS_API_URL=http://127.0.0.1:18180
DUIX_AVATARS=
DUIX_VOICES=

# ── Lip-sync engines (all optional) ────────────────────────────────────
# "Auto" picks the first configured engine: HeyGen → Replicate → fal →
# mock (simulated, no keys needed). All keys stay server-side.

# HeyGen: reuses HEYGEN_API_KEY above. Optional stock avatar for lip-sync
# jobs that don't upload a face image:
HEYGEN_DEFAULT_AVATAR_ID=

# Replicate (https://replicate.com/account/api-tokens). Also set the
# version hash of a Wav2Lip-style model (model page → API → "version"):
REPLICATE_API_TOKEN=
REPLICATE_LIPSYNC_VERSION=

# fal.ai (https://fal.ai/dashboard/keys). Model id is overridable:
FAL_KEY=
FAL_LIPSYNC_MODEL=fal-ai/musetalk

# ── Open-source avatar animation engines (all optional) ────────────────
# Each engine is an external microservice (local Docker container or remote
# GPU endpoint) speaking the shared jobs contract (POST /jobs,
# GET /jobs/{jobId} — see lib/avatar-engines/types.ts). Leave an engine's
# API_URL empty and it runs SIMULATED jobs, so the whole flow works with
# zero GPUs/keys. API keys are sent as Authorization: Bearer headers and
# never reach the browser.

# ComfyUI — drive a locally running ComfyUI (with the
# ComfyUI-LatentSyncWrapper custom node) for top-quality free local
# lip-sync. Just point at your ComfyUI server:
COMFYUI_API_URL=http://127.0.0.1:8188
# Optional: absolute path of ComfyUI's input folder (improves video_path
# resolution), e.g. C:\ComfyUI_windows_portable\ComfyUI\input
COMFYUI_INPUT_DIR=
# Optional: your own exported API-format workflow containing the literal
# placeholders VIDEO_INPUT_PLACEHOLDER and AUDIO_INPUT_PLACEHOLDER
COMFYUI_WORKFLOW_PATH=
# Optional: custom node class override (default LatentSync1.6)
COMFYUI_LATENTSYNC_NODE=

# Wav2Lip — https://github.com/Rudrabha/Wav2Lip (free local lip-sync; the
# easiest self-hosted engine to run on a Windows NVIDIA GPU, no Docker).
# Reference service: engines/wav2lip-service/ (setup.bat, then run.bat).
WAV2LIP_API_URL=
WAV2LIP_API_KEY=

# LatentSync — https://github.com/bytedance/LatentSync (highest quality)
LATENTSYNC_API_URL=
LATENTSYNC_API_KEY=

# EchoMimic — https://github.com/antgroup/echomimic (expressive portraits)
ECHOMIMIC_API_URL=
ECHOMIMIC_API_KEY=

# MuseTalk (self-hosted) — https://github.com/TMElyralab/MuseTalk (fast/realtime)
MUSETALK_API_URL=
MUSETALK_API_KEY=

# LivePortrait — https://github.com/KwaiVGI/LivePortrait (portrait animation)
LIVEPORTRAIT_API_URL=
LIVEPORTRAIT_API_KEY=

# VideoReTalking — https://github.com/OpenTalker/video-retalking (dub existing video)
VIDEORETALKING_API_URL=
VIDEORETALKING_API_KEY=

# Default engine selection when the user picks nothing ("auto" routes by goal)
AVATAR_ENGINE_DEFAULT=auto

# ── Stripe (placeholder — billing is not wired up yet) ─────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
