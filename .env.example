# Supabase project URL (public — safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon/public API key (public — safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role key — SERVER-ONLY, never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=

# Path to the yt-dlp binary (defaults to /usr/bin/yt-dlp)
YTDLP_BIN=/usr/bin/yt-dlp

# Optional path to a cookies file passed to yt-dlp via --cookies
YTDLP_COOKIES_PATH=

# Directory used to store transcript/subtitle temp files
TRANSCRIPT_TMP_DIR=/tmp/watchdeck-transcripts

# Set to 1 to run scripts/mock-yt-dlp.mjs instead of the real yt-dlp binary
YTDLP_MOCK=
